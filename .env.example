# Copy to .env (git-ignored) and fill in. Never commit .env.
XRPL_NETWORK=testnet
# SOURCE_TAG=            # set once the hackathon platform assigns one
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_MINUTES=60
POLL_INTERVAL_S=30
TAINT_MIN_RATIO=0.01
TAINT_MIN_DROPS=1000000
TRACE_MAX_HOPS=6
LOG_LEVEL=INFO
# Local (non-docker) runs; docker-compose overrides these with service hostnames.
DATABASE_URL=postgresql+psycopg://ixh26:ixh26@localhost:5432/ixh26
REDIS_URL=redis://localhost:6379/0
# Demo wallets are written here by scripts/new_wallets.py as XRPL_SEED_<NAME>=...
